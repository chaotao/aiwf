{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiwf/schemas/run_record.schema.json",
  "title": "AIWorkflowRunRecord",
  "description": "Audit record for one workflow run. One JSON file per run. The engine is a state machine driven by an external AI agent: user input, task output, review verdicts and revisions are all recorded as append-only events plus per-node runs.",
  "type": "object",
  "required": [
    "schema_version", "run_id", "workflow_id", "status", "phase",
    "started_at", "inputs", "context", "node_runs", "events",
    "next_node", "node_started_at", "revision", "pending_review", "last_feedback",
    "parent", "subflow_state"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "run_id": { "type": "string" },
    "workflow_id": { "type": "string" },
    "workflow_version": { "enum": ["1.0", "1.1"] },
    "activation_id": { "type": "string" },
    "pending_check": {
      "type": ["object", "null"],
      "properties": {
        "node_id": { "type": "string" },
        "attempt": { "type": "integer", "minimum": 1 },
        "max_attempts": { "type": "integer", "minimum": 1 },
        "criteria": { "type": "array", "items": { "type": "string" } },
        "output": {},
        "started_at": { "type": "string" },
        "exhausted": { "type": "boolean" }
      },
      "required": ["node_id", "attempt", "max_attempts", "criteria", "output", "started_at"],
      "additionalProperties": false
    },
    "parent": {
      "description": "Linkage to the parent run when this record is a subflow child; null for top-level runs.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/parent_link" }]
    },
    "subflow_state": {
      "description": "State of the active/completed subflow or foreach node; null otherwise.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/subflow_state" }]
    },
    "queues": {
      "type": "object",
      "description": "Engine-owned foreach queues (nodes declaring items: {\"queue\": true}), keyed by node id. Recorded before the node starts, because `aiwf items add` may seed a queue that feeds a node reached later.",
      "additionalProperties": { "$ref": "#/$defs/queue" }
    },
    "status": {
      "type": "string",
      "enum": ["running", "completed", "failed"]
    },
    "phase": {
      "type": "string",
      "enum": ["executing", "awaiting_input", "awaiting_review", "awaiting_items", "awaiting_check"],
      "description": "Sub-state within status=running: executing normally, waiting for user input, waiting for human review, or (engine-owned queue) waiting for more items."
    },
    "started_at": { "type": "string" },
    "ended_at": { "type": ["string", "null"] },
    "duration_ms": { "type": ["integer", "null"] },
    "inputs": { "type": "object", "description": "Raw inputs of this run." },
    "context": {
      "type": "object",
      "description": "Latest shared context snapshot. Source for resume and template rendering. Values are small: large artifacts are stored as file references {\"$file\": \"path\"} (single node output <= 2000 chars)."
    },
    "next_node": {
      "type": ["string", "null"],
      "description": "Current node when running; null once completed."
    },
    "node_started_at": {
      "type": ["string", "null"],
      "description": "When next_node became active. Used for node duration on completion."
    },
    "error": {
      "type": ["string", "null"],
      "description": "Failure reason when status=failed."
    },
    "last_feedback": {
      "type": ["string", "null"],
      "description": "Most recent reviewer feedback; served with the redone task spec."
    },
    "pending_review": {
      "description": "State of the current acceptance gate when phase=awaiting_review; null otherwise.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/pending_review" }]
    },
    "revision": {
      "description": "Current/last revision (runtime out-of-plan jump). null until one happens; replaced on each new revision, history stays in events.",
      "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/revision" }]
    },
    "node_runs": {
      "type": "array",
      "items": { "$ref": "#/$defs/node_run" }
    },
    "events": {
      "type": "array",
      "description": "Append-only event stream: user input, input changes, review gates/verdicts, revision lifecycle.",
      "items": { "$ref": "#/$defs/event" }
    }
  },
  "$defs": {
    "queue": {
      "type": "object",
      "description": "One engine-owned queue. `items` is the callers' data, `done` is the seal; the per-item execution status is NOT stored here -- it is read from subflow_state.instances, so the two cannot drift.",
      "required": ["items", "done"],
      "additionalProperties": false,
      "properties": {
        "items": {
          "type": "array",
          "description": "Each item is {id, name, ...caller extensions}; id is unique in the queue and keys the instance."
        },
        "done": {
          "type": "boolean",
          "description": "Sealed by `aiwf items seal`: no more additions, and an empty queue finishes the node instead of waiting."
        }
      }
    },
    "parent_link": {
      "type": "object",
      "required": ["workflow_id", "run_id", "node_id", "instance"],
      "additionalProperties": false,
      "properties": {
        "workflow_id": { "type": "string", "description": "Immediate parent workflow id." },
        "run_id": { "type": "string", "description": "Immediate parent run id." },
        "node_id": { "type": "string", "description": "Parent node owning this child." },
        "instance": { "type": "string", "description": "Instance key ('0' for single subflow)." }
      }
    },
    "instance": {
      "type": "object",
      "required": ["key", "index", "status", "run_id", "started_at", "ended_at", "error", "exports"],
      "additionalProperties": false,
      "properties": {
        "key": { "type": "string" },
        "index": { "type": "integer", "minimum": 0 },
        "status": {
          "type": "string",
          "enum": ["pending", "running", "success", "failed"]
        },
        "run_id": { "type": ["string", "null"] },
        "started_at": { "type": ["string", "null"] },
        "ended_at": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] },
        "exports": { "type": "object" }
      }
    },
    "subflow_state": {
      "type": "object",
      "required": [
        "node_id", "status", "kind", "subflow_id", "inline",
        "items_mode", "items_source", "as", "index_as", "id_field",
        "cursor", "total_seen", "done", "returning", "on_fail",
        "output_key", "instances"
      ],
      "additionalProperties": false,
      "properties": {
        "node_id": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "kind": { "type": "string", "enum": ["single", "foreach"] },
        "subflow_id": { "type": "string", "description": "Resolved workflow id; synthetic id for inline foreach." },
        "inline": { "type": "boolean" },
        "items_mode": {
          "oneOf": [{ "type": "null" }, { "type": "string", "enum": ["static", "queue"] }]
        },
        "items_source": { "description": "Original items spec; null for single calls." },
        "items_snapshot": { "type": "string", "description": "1.1 immutable/append-only item snapshot file." },
        "as": { "type": "string" },
        "index_as": { "type": "string" },
        "id_field": { "oneOf": [{ "type": "null" }, { "type": "string" }] },
        "cursor": { "type": "integer", "minimum": 0, "description": "Next instance position to process." },
        "total_seen": { "type": "integer", "minimum": 0, "description": "Items length at last boundary read." },
        "done": { "type": "boolean", "description": "Dynamic source done marker." },
        "returning": { "type": "boolean", "description": "redo mode: finish the node right after the current instance." },
        "on_fail": { "type": "string", "enum": ["abort", "continue"] },
        "output_key": { "type": "string", "description": "Parent context key: output_key (single) or outputs_key (foreach)." },
        "instances": {
          "type": "array",
          "items": { "$ref": "#/$defs/instance" }
        }
      }
    },
    "pending_review": {
      "type": "object",
      "required": ["kind", "node_id", "requirements", "routes", "attempt"],
      "additionalProperties": false,
      "properties": {
        "kind": { "type": "string", "enum": ["embedded", "standalone"] },
        "node_id": {
          "type": "string",
          "description": "embedded: the task node under review; standalone: the review checkpoint node."
        },
        "requirements": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "description": "Rendered acceptance criteria."
        },
        "routes": {
          "type": "object",
          "description": "Rendered verdict routes: APPROVE/REJECT -> node id or null (null = follow edges / redo subject)."
        },
        "attempt": { "type": "integer", "minimum": 1 }
      }
    },
    "revision": {
      "type": "object",
      "required": [
        "seq", "target", "requested_from", "reason", "mode", "scope",
        "stale_nodes", "reused_nodes", "redone_nodes", "status", "started_at"
      ],
      "additionalProperties": false,
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "target": { "type": "string", "description": "Node being revised (a task node)." },
        "requested_from": { "type": "string", "description": "Node where the revision was requested." },
        "reason": { "type": "string" },
        "mode": {
          "type": "string", "enum": ["cascade", "return"],
          "description": "cascade: redoes propagate along data flow; return: jump back to requested_from after target."
        },
        "scope": {
          "type": "string", "enum": ["auto", "all", "manual"],
          "description": "auto: dependency-graph closure; all: every downstream node; manual: explicitly listed."
        },
        "stale_nodes": { "type": "array", "items": { "type": "string" } },
        "reused_nodes": { "type": "array", "items": { "type": "string" } },
        "redone_nodes": { "type": "array", "items": { "type": "string" } },
        "return_to": { "type": ["string", "null"] },
        "status": { "type": "string", "enum": ["active", "completed"] },
        "started_at": { "type": "string" },
        "ended_at": { "type": ["string", "null"] }
      }
    },
    "event": {
      "type": "object",
      "required": ["type", "at"],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "run_started", "input_provided", "input_changed",
            "review_requested", "review_decided",
            "revise_requested", "node_reused", "revision_completed",
            "output_rejected",
            "check_requested", "check_decided",
            "subflow_started", "instance_completed", "instance_failed",
            "instance_redone",
            "queue_items_added", "queue_item_updated", "queue_item_removed",
            "queue_item_moved", "queue_sealed",
            "run_resumed", "run_failed"
          ]
        },
        "at": { "type": "string" },
        "seq": { "type": "integer" },
        "node_id": { "type": "string" },
        "values": { "type": "object" },
        "fields": { "type": "array", "items": { "type": "string" } },
        "items": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Queue item ids touched by this event."
        },
        "item": {
          "type": "string",
          "description": "Queue item id touched by this event."
        },
        "to": {
          "type": "integer",
          "description": "Destination index of a queue_item_moved event."
        },
        "verdict": { "type": "string" },
        "feedback": { "type": "string" },
        "requirements": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "target": { "type": "string" },
        "requested_from": { "type": "string" },
        "return_to": { "type": "string" },
        "reason": { "type": "string" },
        "mode": { "type": "string" },
        "scope": { "type": "string" },
        "stale_nodes": { "type": "array", "items": { "type": "string" } },
        "reused_nodes": { "type": "array", "items": { "type": "string" } },
        "redone_nodes": { "type": "array", "items": { "type": "string" } },
        "instance": { "type": "string" },
        "child_run_id": { "type": "string" },
        "attempt": { "type": "integer" },
        "started_at": { "type": "string" },
        "duration_ms": { "type": "integer" },
        "input": {},
        "output": {},
        "summary": { "type": "string", "maxLength": 160 }
      }
    },
    "node_run": {
      "type": "object",
      "required": [
        "node_id", "node_name", "type", "status",
        "started_at", "ended_at", "duration_ms",
        "input", "summary", "output"
      ],
      "additionalProperties": false,
      "properties": {
        "node_id": { "type": "string" },
        "node_name": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["start", "task", "branch", "review", "end", "subflow", "foreach"]
        },
        "status": {
          "type": "string",
          "enum": ["success", "failed", "skipped", "rejected"],
          "description": "skipped = prior output reused during a cascade revision; rejected = output failed output_schema and the node stayed open."
        },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "duration_ms": { "type": "integer" },
        "model": {
          "type": ["string", "null"],
          "description": "Model used by the executing agent, self-reported at completion. Null if not reported."
        },
        "tokens": {
          "type": ["object", "null"],
          "description": "Token usage of the agent's LLM call, self-reported if available.",
          "required": ["prompt_tokens", "completion_tokens", "total_tokens"],
          "additionalProperties": false,
          "properties": {
            "prompt_tokens": { "type": "integer" },
            "completion_tokens": { "type": "integer" },
            "total_tokens": { "type": "integer" }
          }
        },
        "decision": {
          "type": ["object", "null"],
          "description": "[branch] The agent's answer and the engine-selected route.",
          "required": ["answer", "route"],
          "properties": {
            "answer": { "type": "string" },
            "route": { "type": "string" }
          }
        },
        "feedback": {
          "type": ["string", "null"],
          "description": "Reviewer feedback that drove this (re)execution."
        },
        "revision_seq": {
          "type": ["integer", "null"],
          "description": "Revision sequence when this run belongs to a revision."
        },
        "input": {
          "description": "Rendered execution spec actually served: prompt for task/branch; null for start/end/skipped."
        },
        "summary": {
          "type": "string",
          "description": "Short auto-generated summary of the output (<=160 chars)."
        },
        "output": {
          "description": "Output reported by the agent (<= 2000 chars serialized); prior output for skipped nodes. Large content is a file reference {\"$file\": \"path\"}, not inline text."
        }
      }
    }
  }
}
