{
  "schema_version": "1.1",
  "id": "novel-chapters",
  "name": "小说：逐章创作与连续性",
  "max_steps": 100,
  "input_schema": {
    "type": "object",
    "required": ["chapters"],
    "properties": {
      "chapters": {
        "type": "array",
        "minItems": 1,
        "maxItems": 20,
        "items": {
          "type": "object",
          "required": ["number", "title"],
          "properties": {"number": {"type": "integer", "minimum": 1}, "title": {"type": "string"}}
        }
      }
    }
  },
  "nodes": [
    {
      "id": "write_chapters",
      "type": "foreach",
      "items": {"ref": "chapters"},
      "id_field": "number",
      "max_instances": 20,
      "inputs": {"previous": {"ref": "previous"}},
      "nodes": [
        {
          "id": "draft",
          "type": "task",
          "inputs": {"chapter": {"ref": "item"}, "previous": {"ref": "previous"}},
          "prompt": "按 chapter 创作正文，汉字数 800–1200，不计标点与空白；previous 非空时读取 previous.draft 文件，保持事件与人物连续。",
          "output": {"file": "${run.dir}/chapter-${item.number}.md"},
          "check": {
            "criteria": ["实测正文汉字数在 800–1200 之间", "与前章连续且本章冲突推进"],
            "max_attempts": 3
          }
        }
      ],
      "exports": ["draft"]
    },
    {
      "id": "assemble",
      "type": "task",
      "inputs": {"manifest": {"ref": "write_chapters"}},
      "prompt": "读取 manifest 文件，确认每项 success，按清单顺序读取 exports.draft 并合并；若存在失败项明确报告。",
      "output": {"file": "${run.dir}/novel.md"},
      "review": {"requirements": ["全书连续、章节齐全，可以交付"]}
    }
  ]
}
