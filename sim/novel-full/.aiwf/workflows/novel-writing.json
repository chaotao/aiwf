{
  "schema_version": "1.1",
  "id": "novel-writing",
  "name": "通用小说创作",
  "description": "立项、世界观、人物、大纲、按清单逐章创作与有限返工、人工验收、汇总成书。",
  "max_steps": 200,
  "input_schema": {
    "type": "object", "required": ["idea"],
    "properties": {"idea": {"type": "string", "description": "一句话灵感或题材方向"}}
  },
  "nodes": [
    {
      "id": "concept", "type": "task", "name": "构思立项",
      "user_input_schema": {
        "type": "object", "required": ["genre", "tone", "target_chapters"],
        "properties": {
          "genre": {"type": "string", "title": "题材"},
          "tone": {"type": "string", "title": "风格基调"},
          "target_chapters": {"type": "integer", "minimum": 1, "maximum": 100, "title": "目标章节数"}
        }
      },
      "inputs": {
        "idea": {"ref": "idea"}, "genre": {"ref": "genre"},
        "tone": {"ref": "tone"}, "target_chapters": {"ref": "target_chapters"}
      },
      "prompt": "写概念简报，包含核心卖点、主角初始处境、贯穿全书的冲突、主题与新意。",
      "output": {"file": "${run.dir}/novel/00-concept.md"}
    },
    {
      "id": "worldbuilding", "type": "task", "name": "世界观",
      "inputs": {"concept": {"ref": "concept"}},
      "prompt": "读取概念简报，构建设定：时代地理、势力关系、核心规则与能力边界、社会日常、禁忌与代价。规则必须自洽且可推演。",
      "output": {"file": "${run.dir}/novel/01-worldbuilding.md"},
      "review": {"requirements": ["与概念方向一致", "规则与能力边界自洽", "为冲突提供舞台、代价和悬念"]}
    },
    {
      "id": "characters", "type": "task", "name": "人物",
      "inputs": {"concept": {"ref": "concept"}, "worldbuilding": {"ref": "worldbuilding"}},
      "prompt": "设计主角的目标、缺陷、能力代价与成长弧线；2-3 名有独立欲望的配角；动机成立的反派；人物关系网及变化。",
      "output": {"file": "${run.dir}/novel/02-characters.md"},
      "review": {"requirements": ["符合世界观", "主角欲望、缺陷与成长明确", "反派动机成立、关系有张力"]}
    },
    {
      "id": "outline", "type": "task", "name": "全书大纲与章节清单",
      "inputs": {
        "concept": {"ref": "concept"}, "worldbuilding": {"ref": "worldbuilding"},
        "characters": {"ref": "characters"}, "count": {"ref": "target_chapters"}
      },
      "prompt": "写完整大纲，覆盖起承转合、转折高潮、悬念链和人物弧线。另写章节清单到 ${run.dir}/novel/chapters.json，恰好 ${target_chapters} 项，number 从1连续编号，每项含 number/title/summary/key_events/hook。输出 {$file:大纲路径,chapters:{$file:清单路径}}；不得把大纲或整份清单内联。",
      "output": {"file": "${run.dir}/novel/03-outline.md"},
      "output_schema": {
        "type": "object", "required": ["$file", "chapters"],
        "properties": {
          "$file": {"type": "string"},
          "chapters": {"type": "object", "required": ["$file"], "properties": {"$file": {"type": "string"}}}
        }
      },
      "check": {
        "criteria": ["用工具读取清单，确认实际项数等于目标章节数且编号连续唯一", "大纲、关键事件、人物弧线和章尾钩子完整"],
        "max_attempts": 3
      },
      "review": {"requirements": ["主线完整、转折高潮清晰", "恰好 ${target_chapters} 章且节奏均衡", "冲突、钩子与人物弧线落地"]}
    },
    {
      "id": "chapters", "type": "foreach", "name": "逐章创作与验收",
      "items": {"ref": "outline.chapters"}, "id_field": "number", "max_instances": 100,
      "inputs": {
        "outline": {"ref": "outline"}, "worldbuilding": {"ref": "worldbuilding"},
        "characters": {"ref": "characters"}, "previous": {"ref": "previous"}
      },
      "nodes": [
        {
          "id": "chapter_outline", "type": "task", "name": "章节细纲",
          "inputs": {
            "chapter": {"ref": "item"}, "outline": {"ref": "outline"},
            "worldbuilding": {"ref": "worldbuilding"}, "characters": {"ref": "characters"},
            "previous": {"ref": "previous"}
          },
          "prompt": "按当前 chapter 写细纲：本章作用、场景时间地点、事件冲突、对白要点、视点、章尾钩子。previous 非空时读取前章正文，记录衔接状态；不从目录推断章号。",
          "output": {"file": "${run.dir}/plan.md"}
        },
        {
          "id": "draft", "type": "task", "name": "正文与修订",
          "inputs": {
            "chapter": {"ref": "item"}, "plan": {"ref": "chapter_outline"},
            "worldbuilding": {"ref": "worldbuilding"}, "characters": {"ref": "characters"},
            "previous": {"ref": "previous"}
          },
          "prompt": "严格按细纲创作本章 2000-3000 汉字正文，场景化呈现、对白动作结合、避免大段说明。读取前章（若有）确保衔接。返工按 feedback 修改同一文件。用工具统计实际汉字数，输出 {$file:正文路径,word_count:实测字数}。",
          "output": {"file": "${run.dir}/chapter-${item.number}.md"},
          "output_schema": {
            "type": "object", "required": ["$file", "word_count"],
            "properties": {
              "$file": {"type": "string"},
              "word_count": {"type": "integer", "minimum": 2000, "maximum": 3000}
            }
          },
          "check": {
            "criteria": [
              "实际正文为2000-3000汉字，工具测量与上报一致",
              "关键事件与细纲完整落实、冲突有实质推进且章尾有钩子",
              "人物行为、口吻、世界规则与前章衔接一致",
              "没有水文、逻辑断裂或人物崩坏；不合格必须给出具体段落和修订理由"
            ],
            "max_attempts": 3
          },
          "review": {"requirements": ["剧情落实细纲", "人物行为和口吻符合设定", "章尾吸引继续阅读", "与前章连续"]}
        }
      ],
      "exports": ["draft"],
      "outputs_key": "chapter_results"
    },
    {
      "id": "assemble", "type": "task", "name": "汇总定稿",
      "inputs": {
        "concept": {"ref": "concept"}, "results": {"ref": "chapter_results"},
        "target": {"ref": "target_chapters"}
      },
      "prompt": "读取结果清单，确认恰好目标数量且每项success，再按清单顺序读取各章。添加书名、简介和目录，拼接全书并检查衔接，不使用目录计数。",
      "output": {"file": "${run.dir}/novel/full-novel.md"},
      "review": {"requirements": ["共 ${target_chapters} 章、顺序目录正确", "衔接通顺，无断裂重复", "全书构成完整故事"]}
    }
  ]
}
