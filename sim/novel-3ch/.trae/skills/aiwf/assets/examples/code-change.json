{
  "schema_version": "1.1",
  "id": "code-change",
  "name": "软件开发：修复、验证与验收",
  "max_steps": 50,
  "input_schema": {
    "type": "object",
    "required": ["project_dir", "request"],
    "properties": {
      "project_dir": {"type": "string"},
      "request": {"type": "string"}
    }
  },
  "nodes": [
    {
      "id": "fix",
      "type": "task",
      "inputs": {
        "project_dir": {"ref": "project_dir"},
        "request": {"ref": "request"},
        "artifact_dir": "${run.dir}"
      },
      "prompt": "读取目标项目约定并定位 request 的问题，修改真实源文件，运行与变更相称的验证。把真实命令与结果写入 artifact_dir 下 validation.txt。返回简短 summary、相对项目路径 changed_files、validation 的真实 exit_code 与 report 文件引用；不要虚构未执行的验证。",
      "output_schema": {
        "type": "object",
        "required": ["summary", "changed_files", "validation"],
        "properties": {
          "summary": {"type": "string", "maxLength": 160},
          "changed_files": {"type": "array", "items": {"type": "string"}},
          "validation": {
            "type": "object",
            "required": ["exit_code", "report"],
            "properties": {
              "exit_code": {"type": "integer"},
              "report": {"type": "object", "required": ["$file"], "properties": {"$file": {"type": "string"}}}
            }
          }
        }
      },
      "check": {
        "criteria": ["修改解决了原始问题且没有无关变更", "验证报告文件存在，记录真实命令与结果", "validation.exit_code 为 0 且验证覆盖关键边界"],
        "max_attempts": 3
      },
      "review": {"requirements": ["变更范围与验证证据满足需求"]}
    }
  ]
}
