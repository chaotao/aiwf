{
  "schema_version": "1.1",
  "id": "novel-3ch",
  "name": "三章末世重生短篇",
  "description": "大纲与三章清单、逐章创作与有限质检返工、汇总与人工终审。",
  "max_steps": 80,
  "input_schema": {
    "type": "object", "required": ["theme"],
    "properties": {"theme": {"type": "string"}}
  },
  "nodes": [
    {
      "id": "plan", "type": "task", "name": "企划与大纲",
      "user_input_schema": {
        "type": "object", "required": ["premise", "protagonist"],
        "properties": {
          "premise": {"type": "string", "title": "核心设定"},
          "protagonist": {"type": "string", "title": "主角设定"}
        }
      },
      "inputs": {
        "theme": {"ref": "theme"}, "premise": {"ref": "premise"},
        "protagonist": {"ref": "protagonist"}
      },
      "prompt": "写三幕短篇大纲，建立重生规则与末世矛盾：觉醒、升级、决战结局。大纲写预期文件，输出 {$file:大纲路径,chapters:[三项]}。每项 number/title/summary/key_events，number依次1、2、3，摘要100字以内，3-5个事件，足以展开800-1200汉字。",
      "output": {"file": "${run.dir}/outline.md"},
      "output_schema": {
        "type": "object", "required": ["$file", "chapters"],
        "properties": {
          "$file": {"type": "string"},
          "chapters": {
            "type": "array", "minItems": 3, "maxItems": 3,
            "items": {
              "type": "object", "required": ["number", "title", "summary", "key_events"],
              "properties": {
                "number": {"type": "integer", "minimum": 1, "maximum": 3},
                "title": {"type": "string"}, "summary": {"type": "string", "maxLength": 100},
                "key_events": {"type": "array", "minItems": 3, "maxItems": 5, "items": {"type": "string"}}
              }
            }
          }
        }
      },
      "check": {
        "criteria": ["三幕故事闭合且符合材料设定", "编号连续1至3，每项可展开800-1200汉字"],
        "max_attempts": 3
      },
      "review": {"requirements": ["末世重生规则自洽", "三幕完整且衔接连贯", "每章足以展开800-1200字"]}
    },
    {
      "id": "chapters", "type": "foreach", "name": "逐章创作",
      "items": {"ref": "plan.chapters"}, "id_field": "number", "max_instances": 3,
      "inputs": {
        "outline": {"ref": "plan"}, "theme": {"ref": "theme"},
        "previous": {"ref": "previous"}
      },
      "nodes": [
        {
          "id": "draft", "type": "task", "name": "正文",
          "inputs": {
            "chapter": {"ref": "item"}, "outline": {"ref": "outline"},
            "previous": {"ref": "previous"}, "theme": {"ref": "theme"}
          },
          "prompt": "读取大纲和前章（previous非空时），按chapter的关键事件写800-1200汉字正文。首行为标题，不引入重大新设定，末章完整收束。用工具统计汉字，输出 {$file:正文路径,title:本章标题,word_count:实测汉字数}；修订按feedback改同一文件。",
          "output": {"file": "${run.dir}/chapter-${item.number}.md"},
          "output_schema": {
            "type": "object", "required": ["$file", "title", "word_count"],
            "properties": {
              "$file": {"type": "string"}, "title": {"type": "string"},
              "word_count": {"type": "integer", "minimum": 800, "maximum": 1200}
            }
          },
          "check": {
            "criteria": [
              "工具实测800-1200汉字且与上报一致",
              "完整覆盖key_events，设定与大纲一致，前后章连贯",
              "末世氛围和人物行动可信，冲突推进且章尾有钩子，末章收束完整"
            ],
            "max_attempts": 3
          }
        }
      ],
      "exports": ["draft"],
      "outputs_key": "chapter_results"
    },
    {
      "id": "assemble", "type": "task", "name": "汇编与交付",
      "inputs": {"results": {"ref": "chapter_results"}, "plan": {"ref": "plan"}},
      "prompt": "读取结果清单，核对3项success后按顺序读正文，添加书名与简短前言（不计正文），汇编成书，无遗漏重复。输出 {$file:成书路径,total_word_count:实际正文总字数}。清单即交付索引，无需额外空定稿节点。",
      "output": {"file": "${run.dir}/novel.md"},
      "output_schema": {
        "type": "object", "required": ["$file", "total_word_count"],
        "properties": {
          "$file": {"type": "string"},
          "total_word_count": {"type": "integer", "minimum": 2400, "maximum": 3600}
        }
      },
      "review": {"requirements": ["三章齐全且每章800-1200字", "设定自洽、第三章结局完整", "章节顺序正确，无遗漏重复"]}
    }
  ]
}
